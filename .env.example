# Google Gemini API Key (for payment root-cause diagnosis & merchant intelligence)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override default Gemini model (defaults to gemini-3.6-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# Razorpay Test Mode Credentials (from https://dashboard.razorpay.com/#/access/api-keys)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourKeySecretHere

# Razorpay Webhook Secret (from Webhook configuration in Razorpay Dashboard)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# PostgreSQL Database Connection URL (defaults to postgresql://postgres:postgres@localhost:5432/revenue_guardian)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revenue_guardian
